{
  "name": "exa-desktop",
  "productName": "Exa",
  "version": "0.1.1",
  "description": "Exa for Windows: right-click a folder or file, choose Ask Exa.",
  "author": "Openwist <hello@openwist.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/main.test.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.openwist.exa",
    "productName": "Exa",
    "copyright": "Openwist",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "picker/**/*", "build/icon.png", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "Exa-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
