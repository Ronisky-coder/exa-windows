{
  "name": "exa-desktop",
  "productName": "Exa",
  "version": "0.3.2",
  "description": "Exa Assistant",
  "author": {
    "name": "Openwist Ltd",
    "email": "hello@openwist.com",
    "url": "https://openwist.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/main.test.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.openwist.exa",
    "productName": "Exa",
    "copyright": "Copyright © 2026 Openwist Ltd",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "picker/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Exa-Setup.${ext}",
      "publisherName": [
        "Openwist Ltd"
      ],
      "legalTrademarks": "Exa is a trademark of Openwist Ltd",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "shortcutName": "Exa",
      "uninstallDisplayName": "Exa Assistant",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "homepage": "https://exa.openwist.com"
}